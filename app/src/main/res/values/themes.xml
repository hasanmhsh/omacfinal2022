    <style name="Theme.MyApplication" parent="Theme.MaterialComponents.DayNight.DarkActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/purple_500</item>
        <item name="colorPrimaryVariant">@color/purple_700</item>
        <item name="colorOnPrimary">@color/white</item>
        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/teal_200</item>
        <item name="colorSecondaryVariant">@color/teal_700</item>
        <item name="colorOnSecondary">@color/black</item>
        <!-- Status bar color. -->
        <item name="android:statusBarColor" tools:targetApi="l">@color/status_bar_color</item>
        <!-- Customize your theme here. -->
    </style>

    <style name="PrimaryTextStyle">
        <item name="android:textColor">@color/black</item>
        <item name="android:padding">@dimen/general_text_padding</item>
        <item name="android:textSize">@dimen/medium_text_size</item>
    </style>

    <style name="SecondaryTextStyle">
        <item name="android:textColor">@color/teal_200</item>
        <item name="android:padding">@dimen/general_text_padding</item>
        <item name="android:textSize">@dimen/small_text_size</item>
    </style>

    <style name="PressableStyle">
        <item name="android:background">@drawable/pressable_background</item>
    </style>

    <style name="BuddyMessagePressableStyle">
        <item name="android:background">@drawable/buddy_message_pressable_background</item>
    </style>

    <style name="MyMessagePressableStyle">
        <item name="android:background">@drawable/my_message_pressable_background</item>
    </style>

    <style name="ElegantButtonStyle1">
        <item name="android:background">@drawable/elegant_button_style1_light</item>
        <item name="android:textColor">@color/purple_700</item>
    </style>


    <style name="NonPressableStyle">
        <item name="android:background">@drawable/item_background</item>
        <item name="android:layout_margin">@dimen/margin_xs</item>
    </style>

    <style name="NonPressableStyleNoMargin">
        <item name="android:background">@drawable/item_background</item>
    </style>

    <style name="SentMessageStyle">
        <item name="android:background">@drawable/sent_message_background_light</item>
        <item name="android:layout_margin">@dimen/margin_xs</item>
    </style>

    <style name="ReceivedMessageStyle">
        <item name="android:background">@drawable/received_message_background_light</item>
        <item name="android:layout_margin">@dimen/margin_xs</item>
    </style>

    <style name="Theme.MyApplication.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>

    <style name="Theme.MyApplication.AppBarOverlay" parent="ThemeOverlay.AppCompat.Dark.ActionBar" />

    <style name="Theme.MyApplication.PopupOverlay" parent="ThemeOverlay.AppCompat.Light" />

    <style name="ThemeOverlay.MyApplication.FullscreenContainer" parent="">
<!--        <item name="fullscreenBackgroundColor">@color/light_blue_600</item>-->
<!--        <item name="fullscreenTextColor">@color/light_blue_A200</item>-->
        <item name="fullscreenBackgroundColor">@color/white</item>
        <item name="fullscreenTextColor">@color/white</item>
    </style>

    <style name="ReceivedMessageTriangleStyle">
        <item name="android:background">@drawable/svg_receive_msg_triangle</item>
    </style>



</resources>