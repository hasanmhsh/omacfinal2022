<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:app="http://schemas.android.com/apk/res-auto">
    <data>
        <variable
            name="user"
            type="hasan.mohamed.shehata.myapplication.models.User" />
    </data>
<FrameLayout
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/extraLightPurbleBackground"
    xmlns:android="http://schemas.android.com/apk/res/android" >

        <LinearLayout
            android:id="@+id/loading_container"
            android:layout_gravity="center"
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <ProgressBar
                android:id="@+id/loading_progress"
                android:layout_width="90dp"
                android:layout_height="90dp"
                android:layout_gravity="center"/>
            <TextView
                android:id="@+id/loading_tv"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:textSize="24dp"
                android:fontFamily="@font/nunito"
                android:textFontWeight="600"
                android:text="Loading..."/>
            <TextView
                android:id="@+id/require_internet_connection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:textSize="24dp"
                android:fontFamily="@font/nunito"
                android:textFontWeight="500"
                android:textColor="#FFFF0000"
                android:text="Require internet connection!"/>
        </LinearLayout>


    <androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
        android:visibility="visible"
        android:id="@+id/main_container"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        xmlns:tools="http://schemas.android.com/tools"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        tools:context=".ui.users.UsersFragment"
        android:keepScreenOn="true">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toTopOf="parent"
            android:background="@color/myAccent1"
            android:translationZ="7dp"
            android:padding="0dp">
            <ImageView
                android:translationZ="15dp"
                android:translationY="25dp"
                android:id="@+id/header_my_user_image_view"
                android:layout_width="100dp"
                android:layout_height="100dp"
                android:layout_marginStart="@dimen/padding_very_large"
                android:background="@drawable/user1"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintBottom_toBottomOf="@id/users_list_header_color_box"
                />
            <FrameLayout
                android:id="@+id/users_list_header_color_box"
                android:layout_width="match_parent"
                android:layout_height="90dp"
                android:background="@drawable/my_user_header_background"
                app:layout_constraintTop_toTopOf="parent">
            <ImageView
                android:tintMode="multiply"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/technology2"
                android:scaleType="centerCrop"
                app:tint="#88888888" />
            </FrameLayout>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/users_list_header_info_box"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/upsdk_white"
                android:padding="4dp"
                app:layout_constraintTop_toBottomOf="@id/users_list_header_color_box">
                <TextView
                    android:id="@+id/users_list_header_name_box"
                    app:layout_constraintEnd_toEndOf="@id/users_list_header_info_box"
                    app:layout_constraintTop_toTopOf="@id/users_list_header_info_box"
                    android:layout_width="wrap_content"
                    android:text="@{user.username}"
                    android:layout_marginEnd="30dp"
                    android:layout_height="wrap_content"


                    android:fontFamily="@font/nunito"
                    android:textFontWeight="500"
                    android:textSize="16sp"
                    android:textColor="@color/darkTextColor"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="@{user.userlanguage.languageName}"
                    android:layout_marginEnd="30dp"
                    app:layout_constraintTop_toBottomOf="@id/users_list_header_name_box"
                    app:layout_constraintEnd_toEndOf="parent"


                    android:fontFamily="@font/nunito"
                    android:textFontWeight="400"
                    android:textSize="10sp"
                    android:textColor="@color/darkTextColor"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <TextView
                android:layout_gravity="center"
                android:translationZ="1dp"
                android:id="@+id/users_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/helvetica"
                android:textStyle="bold"
                android:textAlignment="center"
                android:paddingTop="6dp"
                android:paddingBottom="6dp"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:textColor="@color/white"
                android:textSize="16sp"
                android:background="@drawable/box_backround_blue_rounded"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                android:visibility="gone"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <androidx.recyclerview.widget.RecyclerView
            android:layout_marginTop="120dp"
            android:paddingTop="35dp"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/extraLightPurbleBackground"
            android:id="@+id/fragment_recycler_view">

        </androidx.recyclerview.widget.RecyclerView>

    </androidx.constraintlayout.widget.ConstraintLayout>
</FrameLayout>
</layout>