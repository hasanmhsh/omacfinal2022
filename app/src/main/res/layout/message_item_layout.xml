<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:app="http://schemas.android.com/apk/res-auto" xmlns:android="http://schemas.android.com/apk/res/android">
    <data>
        <variable
            name="message"
            type="hasan.mohamed.shehata.myapplication.models.Message" />
    </data>
<androidx.constraintlayout.widget.ConstraintLayout
    android:id="@+id/message_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_marginStart="3dp"
    android:layout_marginEnd="3dp"
    android:layout_marginBottom="6dp"
    android:paddingTop="@dimen/margin_l">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/message_view_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="60dp"
        android:layout_marginEnd="60dp"
        app:layout_constraintTop_toTopOf="parent"
        android:padding="@dimen/general_text_padding"
        android:background="@drawable/my_message_pressable_background">

        <TextView
            android:visibility="visible"
            android:id="@+id/sender_name_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            android:fontFamily="@font/nunito"
            android:textFontWeight="500"
            android:textSize="14sp"

/>
        <TextView
            android:id="@+id/textOfMessageTv"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margin_m"
            app:layout_constraintTop_toBottomOf="@+id/sender_name_tv"
            android:text="@{message.currentMessageText}"
            android:fontFamily="@font/nunito"
            android:textFontWeight="500"
            android:textSize="12sp"
            android:layout_margin="5dp"
            android:textColor="@color/white"/>
        <Switch
            android:visibility="gone"
            android:id="@+id/is_to_show_translated_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margin_m"
            app:layout_constraintTop_toBottomOf="@id/textOfMessageTv"
            app:layout_constraintStart_toStartOf="parent"/>
        <ImageButton
            android:visibility="gone"
            android:id="@+id/delete_message_but"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_baseline_delete_forever_24"
            android:background="@drawable/transparent_button_background"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <ImageButton
            android:visibility="gone"
            android:id="@+id/message_tts_but"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margin_m"
            android:src="@drawable/ic_baseline_volume_up_24"
            android:background="@drawable/transparent_button_background"
            android:layout_marginStart="@dimen/margin_l"
            app:layout_constraintStart_toEndOf="@id/is_to_show_translated_text"
            app:layout_constraintTop_toBottomOf="@id/textOfMessageTv"/>







    </androidx.constraintlayout.widget.ConstraintLayout>
    <ImageView
        android:id="@+id/my_msg_logo"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_width="45dp"
        android:layout_height="45dp"/>
    <ImageView
        android:id="@+id/my_msg_triangle"
        android:layout_width="15dp"
        android:layout_height="13dp"
        android:translationY="-3dp"
        app:layout_constraintStart_toEndOf="@id/my_msg_logo"
        app:layout_constraintTop_toTopOf="parent"
        android:src="@drawable/triangleright2"

        android:visibility="visible"/>

    <ImageView
        android:id="@+id/buddy_msg_logo"
        android:translationZ="4dp"
        android:elevation="4dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_width="45dp"
        android:layout_height="45dp"/>
    <ImageView
        android:id="@+id/buddy_msg_triangle"
        android:layout_width="15dp"
        android:layout_height="13dp"
        android:translationY="-3dp"
        app:layout_constraintEnd_toStartOf="@id/buddy_msg_logo"
        app:layout_constraintTop_toTopOf="parent"
        android:src="@drawable/triangleright3"

        android:visibility="visible"/>




</androidx.constraintlayout.widget.ConstraintLayout>
</layout>