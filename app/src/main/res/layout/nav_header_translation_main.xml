<layout>
    <data>
        <variable
            name="user"
            type="hasan.mohamed.shehata.myapplication.models.User" />
    </data>
<androidx.constraintlayout.widget.ConstraintLayout
xmlns:android="http://schemas.android.com/apk/res/android"
xmlns:app="http://schemas.android.com/apk/res-auto"
android:layout_width="match_parent"
android:layout_height="wrap_content"
app:layout_constraintTop_toTopOf="parent"
android:background="@color/transparent"
android:padding="0dp">
<ImageView
    android:translationZ="15dp"
    android:translationY="25dp"
    android:id="@+id/header_my_user_image_view_nav_view"
    android:layout_width="100dp"
    android:layout_height="100dp"
    android:layout_marginEnd="@dimen/header_user_photo_horizontal_margin"
    android:background="@drawable/user1"
    app:layout_constraintEnd_toEndOf="parent"
    app:layout_constraintBottom_toBottomOf="@id/users_list_header_color_box_nav_view"
    />
<FrameLayout

    android:id="@+id/users_list_header_color_box_nav_view"
    android:layout_width="match_parent"
    android:layout_height="120dp"
    android:background="@drawable/my_user_header_background"
    app:layout_constraintTop_toTopOf="parent">

</FrameLayout>
<androidx.constraintlayout.widget.ConstraintLayout
    android:id="@+id/users_list_header_info_box_nav_view"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="4dp"
    android:background="@color/nav_header_info_box_background_color"
    app:layout_constraintTop_toBottomOf="@id/users_list_header_color_box_nav_view">
    <TextView
        android:id="@+id/users_list_header_name_box_nav_view"
        app:layout_constraintStart_toStartOf="@id/users_list_header_info_box_nav_view"
        app:layout_constraintTop_toTopOf="@id/users_list_header_info_box_nav_view"
        android:layout_width="wrap_content"
        android:text="@{user.username}"
        android:layout_marginStart="15dp"
        android:layout_marginTop="35dp"
        android:layout_height="wrap_content"
        android:fontFamily="@font/nunito"
        android:textFontWeight="500"
        android:textColor="@color/nav_header_name_text_color"

        android:textSize="@dimen/header_my_name_text_size" />
    <TextView
        android:id="@+id/users_list_header_language_box_nav_view"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:text="@{user.userlanguage.languageName}"
        app:layout_constraintTop_toBottomOf="@id/users_list_header_name_box_nav_view"
        app:layout_constraintStart_toStartOf="@id/users_list_header_name_box_nav_view"

        android:fontFamily="@font/nunito"
        android:textFontWeight="400"
        android:textSize="@dimen/header_my_language_text_size"
        android:textColor="@color/nav_header_language_text_color"/>
</androidx.constraintlayout.widget.ConstraintLayout>
<TextView
    android:layout_gravity="center"
    android:translationZ="1dp"
    android:id="@+id/users_title_nav_view"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fontFamily="@font/helvetica"
    android:textStyle="bold"
    android:textAlignment="center"
    android:paddingTop="6dp"
    android:paddingBottom="6dp"
    android:paddingStart="12dp"
    android:paddingEnd="12dp"
    android:textColor="@color/white"
    android:textSize="16sp"
    android:background="@drawable/box_backround_blue_rounded"
    app:layout_constraintEnd_toEndOf="parent"
    app:layout_constraintStart_toStartOf="parent"
    app:layout_constraintTop_toTopOf="parent"
    android:visibility="gone"/>
</androidx.constraintlayout.widget.ConstraintLayout>
</layout>